# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
# NOTE: NO backticks and NO dollar-sign in the desc/blurb text below (shell-eval fragility -- see CLAUDE.md).
register_gate "tests/test_secret_hygiene.py" "SECRET HYGIENE: PASS" "secret-file and repository-content hygiene" "secret-file and repository-content hygiene (real environment/key files stay untracked and high-confidence keys, personal Gmail addresses, and local user paths stay out of tracked or pending content)" "secret hygiene (uses the Git ignore engine and reports only finding categories and repository-relative paths, never matched values)" 40
