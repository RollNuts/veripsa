# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_blast_radius_dampen.py" "BLAST-DAMPEN GATE: PASS" "blast_radius hub-dampening" "blast_radius skips ubiquitous symbol names (defined in more than 3 files) so nav tool does not inflate scope for files that only define constructor-style or other language-wide method names; real callers of unique symbols are still included; normal file blast sets are unchanged" "blast_radius hub-dampening: a file defining a symbol that appears in more than 3 other files (e.g. __construct, toString) must NOT drag in all callers of that name; the ubiquitous symbol is excluded from the match loop by a single pre-pass dict count; callers of unique symbols still appear; gate runs offline with no Postgres" 10
