# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_rename_lane.py" "RENAME LANE GATE: PASS" "renamed-file lane" "renamed-file lane (the GitHub Files API surfaces a rename only as its NEW name; the App now ALSO reserves a FILE-LEVEL lane on the rename SOURCE (previous_filename) so a concurrent edit to the moved file COLLIDES = the false-clear is closed; a COPIED source is NOT surfaced (copy leaves it in place — no cry-wolf); binary/pure-rename/deleted shapes still map to [] and never crash; content-free — only the old path string crosses, never the diff body; control proves the fix is load-bearing not a no-op)" "renamed-file lane (a RENAMED file's OLD path must coordinate — git conflicts with a concurrent edit to it)" 22
