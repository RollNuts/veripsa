# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_engine_robustness.py" "ROBUSTNESS GATE: PASS" "engine robustness" "build_graph never-crash + bounded: size cap (50 MB skipped), giant single-line (1.4 MB), binary with code ext (NUL-probed), zero-byte files (valid empty nodes), non-UTF-8 (latin-1/shift-jis PEP-263), deep dir tree (200 levels), symlink loop (followlinks=False), mid-walk race (OSError caught), permission-denied (OSError caught), giant .gitattributes (NEW: _GITATTRIBUTES_SIZE_CAP=1MB, was unbounded 32s for 21MB), SQL file node dedup (NEW: 2->1 file node, language=sql+content_hash preserved), gitattributes walk once per build_graph (was 2x independent walks)" "build_graph never-crash + bounded on any pathological customer repo: 13 cases covering size/binary/encoding/tree-shape/symlink/race/permission/gitattributes-dos/sql-dup" 45
