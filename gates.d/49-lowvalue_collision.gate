# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_lowvalue_collision.py" "LOW-VALUE COLLISION GATE: PASS" "low-value collision softening" "low-value collision softening (anti-wallpaper: a same-line overlap on a runner/registration list serializes SOFT = a low-stakes heads-up that is STILL surfaced; a real source-file collision stays a hard wait-in-line; a pair colliding on BOTH stays hard = the low-value file can't mask the real collision; the predicate is conservative — deploy.sh / a random .sh are NOT low-value)" "low-value collision softening (a collision ONLY on append-mostly build/test-RUNNER files = run_gates.sh and kin → soft 'heads up', NOT a hard 'wait in line'; a real source collision stays hard; a low-value file never masks a real one; content-free)" 20
