# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_security_perimeter.py" "SECURITY PERIMETER GATE: PASS" "security perimeter" "security perimeter (webhook HMAC verified constant-time + fails CLOSED on an empty secret; a buyer seat forging current_account/installation_account is DENIED at the GRANT layer on direct reads and re-resolved to its OWN account on gate writes [the victim tenant + its same-named coordinate are untouched]; owner-only cost/usage surfaces deny every buyer/seat role; the App's installation_account pin is honored ONLY for a genuinely-routed account so a stray/forged raw SET can never steer a write into a phantom/forged tenant)" "security perimeter / ADVERSARIAL BREACH (a malicious customer tries to cross the wall: HMAC webhook authenticity + cross-tenant read/write + forged-GUC identity + owner-only surfaces + routing-pin integrity; SECURITY-critical)" 20
