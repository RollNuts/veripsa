# Veripsa release gate (auto-discovered). One gate per file. register_gate is defined in run_gates.sh.
# Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_dockerfile_extractor_copy.py" "DOCKERFILE EXTRACTOR-COPY GATE: PASS" "dockerfile extractor-copy completeness" "every ROOT-level module that code_graph_extract.py and the github-app/ App code import is COPY'd into the Docker image (names + globs expanded against the real root files). A pre-fix packaging regression added a root module without adding it to the Dockerfile COPY list, so source-tree tests passed while the built image could not import it. This gate parses actual imports against COPY inputs so a future split with an uncopied root module fails before release" "dockerfile extractor-copy: a root module imported by the extractor/App but absent from the Docker COPY fails the gate, so a built image cannot silently miss a module" 6
