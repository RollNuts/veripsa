# Veripsa release gate (auto-discovered). One gate per file -> two PRs adding gates add two
# FILES, never a shared line -> no false merge conflict on registration. register_gate is
# defined in run_gates.sh. Format: register_gate <test> <marker> <name> <ok_blurb> <desc> [tail]
register_gate "tests/test_neighbor_refresh_cap.py" "NEIGHBOR REFRESH CAP GATE: PASS" "neighbor refresh cap" "neighbor refresh cap (the LIVE push-to-main / PR open-sync neighbor refresh _post_refreshes posts AT MOST VERIPSA_NEIGHBOR_REFRESH_CAP in-flight PRs per event — with N>>cap overlapping changes it touches <=cap, not N; content-free truncation log, never crashes; small-N <=cap is byte-identical/all-posted; a patched cap binds at call time)" "neighbor refresh cap (one push-to-main / open-sync re-renders + POSTS every in-flight PR's check (up to 3 GitHub calls each) under the HELD per-repo advisory lock; this BOUNDS that fan-out so a busy monorepo's hundreds of overlapping PRs can't churn the worker = the live P2 DoS)" 16
